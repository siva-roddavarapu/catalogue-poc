# --- API ---
PORT=3000
# Public URL of the web app; used to build the product link in enquiry emails.
WEB_ORIGIN=http://localhost:5173
# fakestore = live https://fakestoreapi.com (cached) | fixture = committed offline snapshot
PRODUCT_SOURCE=fakestore
FAKESTORE_BASE_URL=https://fakestoreapi.com
CACHE_TTL_SECONDS=300
# ISO 4217 code used to format prices (Fake Store gives no currency).
CURRENCY=USD

# --- Email (Mailpit locally: SMTP on 1025, inbox UI on http://localhost:8025) ---
# docker compose overrides SMTP_HOST to "mailpit"; keep localhost for `npm run dev`.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=catalogue@example.com
SALES_INBOX=sales@example.com
